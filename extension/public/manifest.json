{
  "manifest_version": 3,
  "name": "XSweep",
  "version": "0.2.0",
  "description": "Local, review-first cleanup of your own X posts, reposts, and likes.",
  "action": { "default_title": "Open XSweep" },
  "side_panel": { "default_path": "dashboard.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "tabs", "notifications", "sidePanel"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://abs.twimg.com/*"],
  "content_scripts": [{ "matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content.js"], "run_at": "document_start" }],
  "web_accessible_resources": [{ "matches": ["https://x.com/*", "https://twitter.com/*"], "resources": ["x-header-bridge.js"] }]
}
